{
  "version": 1,
  "description": "Curated reusable ambience references. Entries are added only after machine-verifiable licence, provenance, content hash and automated quality gates pass.",
  "policy": {
    "web_discovery": "outside-render",
    "production": "locked-snapshot",
    "preferred_sources": [
      "Openverse",
      "Wikimedia Commons",
      "Pixabay",
      "Freesound",
      "ZapSplat",
      "Mixkit",
      "Sonniss GameAudioGDC",
      "Free To Use Sounds",
      "Soundly",
      "BOOM Library",
      "Pro Sound Effects",
      "Pond5"
    ],
    "source_license_verification": "machine-only",
    "selection": "automatic",
    "no_selection_action": "continue-discovery",
    "raw_redistribution": "license-dependent",
    "automatic_licenses": ["CC0-1.0", "PDM-1.0", "Public-Domain", "CC-BY-4.0", "CC-BY-3.0"],
    "not_autonomously_promotable": ["unverified", "provider-specific-without-machine-evidence", "CC-BY-SA-*"],
    "rejected_by_default": ["CC-BY-NC-*", "CC-BY-ND-*"]
  },
  "entries": []
}

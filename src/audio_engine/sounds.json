{
  "version": 1,
  "description": "Validated reusable sound resources for spoken-audio soundscapes. Entries are production-ready references selected and promoted by machine policy, not discovery candidates.",
  "policy": {
    "discovery": "broad-multi-source",
    "qualification": "machine",
    "selection": "automatic",
    "no_selection_action": "continue-discovery",
    "publication": "validated-only",
    "production": "locked-asset",
    "render_network_access": false,
    "types": ["ambience", "event"],
    "soundscape_roles": ["bed", "layer", "event"],
    "max_layers": 2,
    "max_events": 16,
    "license_verification": "machine-evidence-required",
    "content_hash_required": true,
    "human_approval_required": false
  },
  "entries": []
}
